# Ruta opcional a un CSV o RDS con el dataset de Orígenes.
# Si se omite, la app busca data/cache/latest.rds, data/origenes.rds
# y data/origenes.csv, en ese orden.
ORIGENES_DATA_PATH=

# Cuenta de shinyapps.io usada por scripts/deploy_shinyapps.R
# y por .github/workflows/daily-refresh.yml (secret opcional en GitHub).
ORIGENES_SHINYAPPS_ACCOUNT=division2cbr

# Brokers: ventana para "activo" (cita en últimos N días). Default 30.
ORIGENES_BROKERS_ACTIVE_DAYS=30

# Misma Bubble Data API que vendedores_dashboard:
BUBBLE_BASE=https://TU_APP.bubbleapps.io/version-test/api/1.1/obj
BUBBLE_TOKEN=tu_token_privado

# App Embajadores (Bubble en ambassadors.mx) — misma auth Bearer:
AMBASSADORS_BASE=https://ambassadors.mx/api/1.1
AMBASSADORS_TOKEN=tu_token_privado

# Fuente Brokers: crm (solo Bubble) | vendedores | bubble
# Default crm = cache vendedores → Bubble live. No usa CSV/Sheets.
ORIGENES_BROKERS_DATA_SOURCE=crm

# Cache RDS del dash de vendedores (misma extracción Bubble):
# ORIGENES_VENDEDORES_BUNDLE=/ruta/a/vendedores_dashboard/data/cache/latest.rds

# --- GitHub Actions (.github/workflows/daily-refresh.yml) ---
# Configurar como repository secrets (Settings → Secrets and variables → Actions):
#   BUBBLE_BASE, BUBBLE_TOKEN
#   AMBASSADORS_BASE, AMBASSADORS_TOKEN
#   SHINYAPPS_TOKEN, SHINYAPPS_SECRET   (tokens de rsconnect / shinyapps.io)
#   ORIGENES_SHINYAPPS_ACCOUNT          (opcional; default division2cbr)
# No commitear SHINYAPPS_* en este archivo.
